    NOP
    NOP
    JAL     check_equal_r2_r3

    ; 90 store/load minint
    ADDUI   R22, R0, 90
    SW      mem3(R0), R20
    NOP
    NOP
    LW      R2, mem3(R0)
    NOP
    NOP
    ADD     R3, R20, R0
    NOP
    NOP
    JAL     check_equal_r2_r3

    ; 91 store/load maxint
    ADDUI   R22, R0, 91
    SW      mem4(R0), R21
    NOP
    NOP
    LW      R2, mem4(R0)
    NOP
    NOP
    ADD     R3, R21, R0
    NOP
    NOP
    JAL     check_equal_r2_r3

    ; 92 J skips one instruction
    ADDUI   R22, R0, 92
    ADDUI   R2, R0, 5
    J       jump_target_92
    ADDUI   R2, R0, 6
jump_target_92
    ADDUI   R3, R0, 5
    NOP
    NOP
    JAL     check_equal_r2_r3

    ; manual print sanity
    ADDUI   R1, R0, 65
    PCH     R1
    ADDUI   R1, R0, 10
    PCH     R1
    ADDUI   R1, R0, 13
    PCH     R1

    ADDUI   R1, R0, 7
    SUB     R1, R0, R1
    PD      R1
    ADDUI   R1, R0, 10
    PCH     R1
    ADDUI   R1, R0, 13
    PCH     R1

    ADDUI   R1, R0, 7
    PDU     R1
    ADDUI   R1, R0, 10
    PCH     R1
    ADDUI   R1, R0, 13
    PCH     R1

    ADDUI   R1, R0, 2
    PDU     R1
    ADDUI   R1, R0, 10
    PCH     R1
    ADDUI   R1, R0, 13
    PCH     R1

    PD      R20
    ADDUI   R1, R0, 10
    PCH     R1
    ADDUI   R1, R0, 13
    PCH     R1

    LW      R1, pass_count(R0)
    NOP
    NOP
    PDU     R1
    ADDUI   R1, R0, 10
    PCH     R1
    ADDUI   R1, R0, 13
    PCH     R1

    LW      R1, fail_count(R0)
    NOP
    NOP
    PDU     R1
    ADDUI   R1, R0, 10
    PCH     R1
    ADDUI   R1, R0, 13
    PCH     R1

    LW      R1, last_fail(R0)
    NOP
    NOP
    PDU     R1

done
    J       done

check_equal_r2_r3
    SUB     R23, R2, R3
    BNEZ    R23, check_fail

check_pass
    LW      R24, pass_count(R0)
    NOP
    NOP
    ADDUI   R24, R24, 1
    NOP
    NOP
    SW      pass_count(R0), R24
    JR      R31

check_fail
    LW      R24, fail_count(R0)
    NOP
    NOP
    ADDUI   R24, R24, 1
    NOP
    NOP
    SW      fail_count(R0), R24
    SW      last_fail(R0), R22
    JR      R31

jr_sub
    ADDUI   R2, R0, 55
    JR      R31

jal_sub
    ADDUI   R2, R0, 66
    JR      R31