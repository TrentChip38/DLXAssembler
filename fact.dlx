.data

n	1	5
f	1	1
;This is just "Welcome" to test. I think it is decimal, not hex?
s	7 87 101 108 99 111 109 101
;Full phrase is s	87 101 108 99 111 109 101 32 116 111 32 116 104 101 32 68 76 88 32 102 97 99 116 111 114 105 97 108 32 112 114 111 103 114 97 109 33

.text
	;Loop to print phrase
	ADDI	R20, R0, 0		;index = 0
	ADDI	R22, R0, 7		;string size = 7
s_loop
	LW  	R21, s(R20)		;load char at index
	ADDI	R20, R20, 1		;index ++
	PCH 	R21				;Print that char
	SLEU R4, R20, R22		;if index <= string size
	BNEZ R4, s_loop			;go back to top of loop

	LW	R11, n(R0)	;R11 is the original value
	LW 	R10, f(R0)	;R10 is the current result
	ADDI	R1, R0, 1	;R1 is a counter 'i'
	ADDI	R3, R0, 1	;R3 is prevresult
n_loop
	SLEU	R9, R1, R11	;if i(R1) <= value(R11) then R9 = 1
	BEQZ	R9, result	;if R9 = 0 end loop
	ADDI R3, R10, 0 ;R3 = current result
	JAL	j_loop_start	;Jump to multiplication loop
	ADDI	R1, R1, 1	;i++
	J	n_loop
result
	SW	R10, f(R0)	;Store result in f(0)
done
	J	done
j_loop_start
	ADDI R2, R0, 1	;R2 is a counter 'j'
j_loop
	SGEU R4, R2, R1	;if j(R2) >= i(R1) then R4 = 1
    BNEZ R4, end_j_loop	;Ending loop if condition
    ADD R10, R10, R3	;result += prevresult
    ADDI R2, R2, 1	;j++
    J j_loop
end_j_loop
	JR	R31