DEPTH = 1024;
WIDTH = 32;
ADDRESS_RADIX = HEX;
DATA_RADIX = HEX;
CONTENT
BEGIN

000 : 05600000; --LW R11 n R0 ;R11 is the original value 
001 : 05400001; --LW R10 f R0 ;R10 is the current result 
002 : 10200001; --ADDI R1 R0 1 ;R1 is a counter 'i' 
003 : 10600001; --ADDI R3 R0 1 ;R3 is prevresult 
004 : 8921000B; --SLEUI R9 R1 R11 ;if i R1 <= value R11 then R9 = 1 
005 : AC09000A; --BEQZ R9 result ;if R9 = 0 end loop 
006 : 106A0000; --ADDI R3 R10 0 ;R3 = current result 
007 : BC00000C; --JAL j_loop_start ;Jump to multiplication loop 
008 : 10210001; --ADDI R1 R1 1 ;i++ 
009 : B4000004; --J n_loop 
00A : 0801000A; --SW R10 f R0 ;Store result in f 0 
00B : B400000B; --J done 
00C : 10400001; --ADDI R2 R0 1 ;R2 is a counter 'j' 
00D : 94820800; --SGEU R4 R2 R1 ;if j R2 >= i R1 then R4 = 1 
00E : B0040012; --BNEZ R4 end_j_loop ;Ending loop if condition 
00F : 0D4A1800; --ADD R10 R10 R3 ;result += prevresult 
010 : 10420001; --ADDI R2 R2 1 ;j++ 
011 : B400000D; --J j_loop 
012 : B800001F; --JR R31 

END;