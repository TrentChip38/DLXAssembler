.data
pass_count      1   0
fail_count      1   0
last_fail       1   0

src0            1   0
src1            1   1
src2            1   2
src3            1   3
src4            1   4
src5            1   5
src6            1   6
src7            1   7
src8            1   8
src9            1   9
src10           1   10
src11           1   11
src12           1   12
src13           1   13
src14           1   14
src15           1   15
src16           1   16

mem0            1   0
mem1            1   0
mem2            1   0
mem3            1   0
mem4            1   0
mem5            1   0
mem6            1   0
mem7            1   0
mem8            1   0
mem9            1   0
mem10           1   0
mem11           1   0
mem12           1   0
mem13           1   0
mem14           1   0
mem15           1   0

flag0           1   0
flag1           1   0
flag2           1   0
flag3           1   0

.const

.text
start
    ADD     R1, R0, R0
    SW      pass_count(R0), R1
    SW      fail_count(R0), R1
    SW      last_fail(R0), R1

    ADDUI   R4, R0, 1
    ADDUI   R5, R0, 2
    ADDUI   R6, R0, 3
    ADDUI   R7, R0, 4
    ADDUI   R8, R0, 5
    ADDUI   R9, R0, 7
    ADDUI   R10, R0, 8
    ADDUI   R11, R0, 9
    ADDUI   R12, R0, 12
    ADDUI   R13, R0, 15
    ADDUI   R14, R0, 16

    ; 1 long ALU dependency chain
    ADDUI   R22, R0, 1
    ADDUI   R15, R0, 1
    ADDUI   R15, R15, 2
    ADDU    R15, R15, R7
    XORI    R15, R15, 1
    ADDUI   R2, R15, 0
    NOP
    NOP
    ADDUI   R3, R0, 6
    JAL     check_equal_r2_r3

    ; 2 mixed reg-reg and reg-imm consumers
    ADDUI   R22, R0, 2
    ADDUI   R15, R0, 5
    ADDUI   R16, R0, 7
    SNE     R17, R15, R16
    ADDU    R2, R17, R4
    NOP
    NOP
    ADDUI   R3, R0, 2
    JAL     check_equal_r2_r3

    ; 3 load-use into logic op
    ADDUI   R22, R0, 3
    LW      R15, src15(R0)
    XORI    R2, R15, 7
    NOP
    NOP
    ADDUI   R3, R0, 8
    JAL     check_equal_r2_r3

    ; 4 load-use into compare op
    ADDUI   R22, R0, 4
    LW      R15, src5(R0)
    SNEI    R2, R15, 4
    NOP
    NOP
    ADDUI   R3, R0, 1
    JAL     check_equal_r2_r3

    ; 5 newest wins after three writes
    ADDUI   R22, R0, 5
    ADDUI   R15, R0, 1
    ADDUI   R15, R0, 7
    ADDUI   R15, R0, 5
    ADDUI   R2, R15, 0
    NOP
    NOP
    ADDUI   R3, R0, 5
    JAL     check_equal_r2_r3

    ; 6 simultaneous two-source forward into ADDU
    ADDUI   R22, R0, 6
    ADDUI   R15, R0, 9
    LW      R16, src7(R0)
    ADDU    R2, R15, R16
    NOP
    NOP
    ADDUI   R3, R0, 16
    JAL     check_equal_r2_r3

    ; 7 simultaneous two-source forward into SNE
    ADDUI   R22, R0, 7
    LW      R15, src8(R0)
    ADDUI   R16, R0, 8
    SNE     R2, R15, R16
    NOP
    NOP
    ADD     R3, R0, R0
    JAL     check_equal_r2_r3

    ; 8 ALU -> SW data
    ADDUI   R22, R0, 8
    ADDUI   R15, R0, 11
    SW      mem0(R0), R15
    NOP
    NOP
    LW      R2, mem0(R0)
    NOP
    NOP
    ADDUI   R3, R0, 11
    JAL     check_equal_r2_r3

    ; 9 ALU -> SW base
    ADDUI   R22, R0, 9
    ADDUI   R15, R0, 3
    SW      mem0(R15), R12
    NOP
    NOP
    LW      R2, mem3(R0)
    NOP
    NOP
    ADDUI   R3, R0, 12
    JAL     check_equal_r2_r3

    ; 10 LW -> SW data
    ADDUI   R22, R0, 10
    LW      R15, src9(R0)
    SW      mem4(R0), R15
    NOP
    NOP
    LW      R2, mem4(R0)
    NOP
    NOP
    ADDUI   R3, R0, 9
    JAL     check_equal_r2_r3

    ; 11 LW -> SW base
    ADDUI   R22, R0, 11
    LW      R15, src5(R0)
    SW      mem0(R15), R8
    NOP
    NOP
    LW      R2, mem5(R0)
    NOP
    NOP
    ADDUI   R3, R0, 5
    JAL     check_equal_r2_r3

    ; 12 base and data both forwarded into SW
    ADDUI   R22, R0, 12
    ADDUI   R15, R0, 6
    ADDUI   R16, R0, 13
    SW      mem0(R15), R16
    NOP
    NOP
    LW      R2, mem6(R0)
    NOP
    NOP
    ADDUI   R3, R0, 13
    JAL     check_equal_r2_r3

    ; 13 store-load same address ordering, direct
    ADDUI   R22, R0, 13
    ADDUI   R15, R0, 7
    SW      mem7(R0), R15
    LW      R2, mem7(R0)
    NOP
    NOP
    ADDUI   R3, R0, 7
    JAL     check_equal_r2_r3

    ; 14 store-load same address ordering, loaded store data
    ADDUI   R22, R0, 14
    LW      R15, src12(R0)
    SW      mem8(R0), R15
    LW      R2, mem8(R0)
    NOP
    NOP
    ADDUI   R3, R0, 12
    JAL     check_equal_r2_r3

    ; 15 store-load same address ordering, forwarded base
    ADDUI   R22, R0, 15
    ADDUI   R15, R0, 2
    SW      mem0(R15), R11
    LW      R2, mem2(R0)
    NOP
    NOP
    ADDUI   R3, R0, 9
    JAL     check_equal_r2_r3

    ; 16 two stores same address, last wins
    ADDUI   R22, R0, 16
    SW      mem9(R0), R8
    SW      mem9(R0), R11
    LW      R2, mem9(R0)
    NOP
    NOP
    ADDUI   R3, R0, 9
    JAL     check_equal_r2_r3

    ; 17 store then load then use
    ADDUI   R22, R0, 17
    ADDUI   R15, R0, 10
    SW      mem10(R0), R15
    LW      R16, mem10(R0)
    ADDUI   R2, R16, 1
    NOP
    NOP
    ADDUI   R3, R0, 11
    JAL     check_equal_r2_r3

    ; 18 load base for later load
    ADDUI   R22, R0, 18
    LW      R15, src7(R0)
    LW      R2, src0(R15)
    NOP
    NOP
    ADDUI   R3, R0, 7
    JAL     check_equal_r2_r3

    ; 19 ALU base for later load
    ADDUI   R22, R0, 19
    ADDUI   R15, R0, 5
    LW      R2, src0(R15)
    NOP
    NOP
    ADDUI   R3, R0, 5
    JAL     check_equal_r2_r3

    ; 20 newest wins for LW base
    ADDUI   R22, R0, 20
    ADDUI   R15, R0, 1
    ADDUI   R15, R0, 7
    LW      R2, src0(R15)
    NOP
    NOP
    ADDUI   R3, R0, 7
    JAL     check_equal_r2_r3

    ; 21 BEQZ taken suppresses wrong-path store
    ADDUI   R22, R0, 21
    SW      flag0(R0), R0
    BEQZ    R0, t21_taken
    SW      flag0(R0), R4
t21_taken
    NOP
    NOP
    LW      R2, flag0(R0)
    NOP
    NOP
    ADD     R3, R0, R0
    JAL     check_equal_r2_r3

    ; 22 BNEZ taken suppresses wrong-path store
    ADDUI   R22, R0, 22
    SW      flag1(R0), R0
    BNEZ    R4, t22_taken
    SW      flag1(R0), R4
t22_taken
    NOP
    NOP
    LW      R2, flag1(R0)
    NOP
    NOP
    ADD     R3, R0, R0
    JAL     check_equal_r2_r3

    ; 23 J suppresses wrong-path store
    ADDUI   R22, R0, 23
    SW      flag2(R0), R0
    J       t23_target
    SW      flag2(R0), R4
t23_target
    NOP
    NOP
    LW      R2, flag2(R0)
    NOP
    NOP
    ADD     R3, R0, R0
    JAL     check_equal_r2_r3

    ; 24 branch taken then J
    ADDUI   R22, R0, 24
    ADDUI   R2, R0, 1
    BEQZ    R0, t24_a
    ADDUI   R2, R0, 99
t24_a
    J       t24_b
    ADDUI   R2, R0, 98
t24_b
    NOP
    NOP
    ADDUI   R3, R0, 1
    JAL     check_equal_r2_r3

    ; 25 J target contains taken branch
    ADDUI   R22, R0, 25
    ADDUI   R2, R0, 1
    J       t25_a
    ADDUI   R2, R0, 99
t25_a
    BNEZ    R4, t25_b
    ADDUI   R2, R0, 98
t25_b
    NOP
    NOP
    ADDUI   R3, R0, 1
    JAL     check_equal_r2_r3

    ; 26 JAL basic call return
    ADDUI   R22, R0, 26
    ADDUI   R2, R0, 1
    JAL     t26_sub
t26_ret
    ADDUI   R2, R0, 2
    NOP
    NOP
    ADDUI   R3, R0, 2
    JAL     check_equal_r2_r3
    J       t26_after
t26_sub
    JR      R31
t26_after

    ; 27 JR using copied R31
    ADDUI   R22, R0, 27
    ADDUI   R2, R0, 1
    JAL     t27_sub
t27_ret
    ADDUI   R2, R0, 3
    NOP
    NOP
    ADDUI   R3, R0, 3
    JAL     check_equal_r2_r3
    J       t27_after
t27_sub
    ADDU    R6, R31, R0
    JR      R6
t27_after

    ; 28 JALR using R31
    ADDUI   R22, R0, 28
    ADDUI   R2, R0, 1
    JAL     t28_sub
t28_ret
    ADDUI   R2, R0, 4
    NOP
    NOP
    ADDUI   R3, R0, 4
    JAL     check_equal_r2_r3
    J       t28_after
t28_sub
    JALR    R31
t28_after

    ; 29 JALR using copied R31
    ADDUI   R22, R0, 29
    ADDUI   R2, R0, 1
    JAL     t29_sub
t29_ret
    ADDUI   R2, R0, 5
    NOP
    NOP
    ADDUI   R3, R0, 5
    JAL     check_equal_r2_r3
    J       t29_after
t29_sub
    ADDU    R6, R31, R0
    JALR    R6
t29_after

    ; 30 randomized-looking ALU sequence
    ADDUI   R22, R0, 30
    ADDUI   R15, R0, 13
    XORI    R15, R15, 6
    ORI     R15, R15, 1
    ANDI    R15, R15, 15
    ADDUI   R2, R15, 0
    NOP
    NOP
    ADDUI   R3, R0, 11
    JAL     check_equal_r2_r3

    ; 31 randomized-looking load/alu/store sequence
    ADDUI   R22, R0, 31
    LW      R15, src14(R0)
    XORI    R15, R15, 3
    SW      mem11(R0), R15
    LW      R2, mem11(R0)
    NOP
    NOP
    ADDUI   R3, R0, 13
    JAL     check_equal_r2_r3

    ; 32 repeated overwrite then store
    ADDUI   R22, R0, 32
    ADDUI   R15, R0, 1
    ADDUI   R15, R0, 2
    ADDUI   R15, R0, 3
    SW      mem12(R0), R15
    NOP
    NOP
    LW      R2, mem12(R0)
    NOP
    NOP
    ADDUI   R3, R0, 3
    JAL     check_equal_r2_r3

    ; 33 repeated overwrite then branch sees newest zero
    ADDUI   R22, R0, 33
    ADDUI   R2, R0, 1
    ADDUI   R15, R0, 1
    ADDUI   R15, R0, 5
    ADDUI   R15, R0, 0
    BEQZ    R15, t33_taken
    ADDUI   R2, R0, 99
t33_taken
    NOP
    NOP
    ADDUI   R3, R0, 1
    JAL     check_equal_r2_r3

    ; 34 repeated overwrite then branch sees newest nonzero
    ADDUI   R22, R0, 34
    ADDUI   R2, R0, 1
    ADDUI   R15, R0, 0
    ADDUI   R15, R0, 2
    ADDUI   R15, R0, 1
    BNEZ    R15, t34_taken
    ADDUI   R2, R0, 99
t34_taken
    NOP
    NOP
    ADDUI   R3, R0, 1
    JAL     check_equal_r2_r3

    ; 35 branch not taken store still happens
    ADDUI   R22, R0, 35
    SW      flag3(R0), R0
    BEQZ    R4, t35_skip
    SW      flag3(R0), R4
t35_skip
    NOP
    NOP
    LW      R2, flag3(R0)
    NOP
    NOP
    ADDUI   R3, R0, 1
    JAL     check_equal_r2_r3

    ; 36 store-load ordering with forwarded data and base
    ADDUI   R22, R0, 36
    ADDUI   R15, R0, 13
    ADDUI   R16, R0, 14
    SW      mem0(R15), R16
    LW      R2, mem13(R0)
    NOP
    NOP
    ADDUI   R3, R0, 14
    JAL     check_equal_r2_r3

    ; 37 load then store then branch on reloaded value
    ADDUI   R22, R0, 37
    LW      R15, src1(R0)
    SW      mem14(R0), R15
    LW      R16, mem14(R0)
    ADDUI   R2, R0, 1
    BNEZ    R16, t37_taken
    ADDUI   R2, R0, 99
t37_taken
    NOP
    NOP
    ADDUI   R3, R0, 1
    JAL     check_equal_r2_r3

    ; 38 store two addresses then sum loaded values
    ADDUI   R22, R0, 38
    SW      mem13(R0), R8
    SW      mem14(R0), R9
    LW      R15, mem13(R0)
    LW      R16, mem14(R0)
    ADDU    R2, R15, R16
    NOP
    NOP
    ADDUI   R3, R0, 12
    JAL     check_equal_r2_r3

    ; 39 JR target with one preprocessing ALU op
    ADDUI   R22, R0, 39
    ADDUI   R2, R0, 1
    JAL     t39_sub
t39_ret
    ADDUI   R2, R0, 6
    NOP
    NOP
    ADDUI   R3, R0, 6
    JAL     check_equal_r2_r3
    J       t39_after
t39_sub
    ADDU    R6, R31, R0
    ADDUI   R6, R6, 0
    JR      R6
t39_after

    ; 40 GDU immediate use should stall if needed
    ADDUI   R22, R0, 40
    GDU     R2
    ADDUI   R2, R2, 1
    NOP
    NOP
    ADDUI   R3, R0, 6
    JAL     check_equal_r2_r3

    LW      R1, pass_count(R0)
    NOP
    NOP
    PDU     R1
    JAL     print_nl

    LW      R1, fail_count(R0)
    NOP
    NOP
    PDU     R1
    JAL     print_nl

    LW      R1, last_fail(R0)
    NOP
    NOP
    PDU     R1
    JAL     print_nl

done
    J       done

print_nl
    ADDUI   R1, R0, 10
    PCH     R1
    ADDUI   R1, R0, 13
    PCH     R1
    JR      R31

check_equal_r2_r3
    SUB     R23, R2, R3
    BNEZ    R23, check_fail

check_pass
    LW      R24, pass_count(R0)
    NOP
    NOP
    ADDUI   R24, R24, 1
    NOP
    NOP
    SW      pass_count(R0), R24
    JR      R31

check_fail
    LW      R24, fail_count(R0)
    NOP
    NOP
    ADDUI   R24, R24, 1
    NOP
    NOP
    SW      fail_count(R0), R24
    SW      last_fail(R0), R22
    JR      R31