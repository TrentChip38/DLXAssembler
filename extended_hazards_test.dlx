    ; 35 ADDUI -> BNEZ taken
    ADDUI   R22, R0, 35
    ADDUI   R2, R0, 1
    ADDUI   R15, R0, 1
    BNEZ    R15, t35_taken
    ADDUI   R2, R0, 99
t35_taken
    NOP
    NOP
    ADDUI   R3, R0, 1
    JAL     check_equal_r2_r3

    ; 36 SNEI -> BNEZ not taken
    ADDUI   R22, R0, 36
    ADDUI   R2, R0, 1
    SNEI    R15, R8, 5
    BNEZ    R15, t36_skip
    ADDUI   R2, R0, 2
t36_skip
    NOP
    NOP
    ADDUI   R3, R0, 2
