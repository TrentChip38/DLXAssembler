t46_ret
    ADDUI   R2, R0, 2
    NOP
    NOP
    ADDUI   R3, R0, 2
    JAL     check_equal_r2_r3
    J       t46_after
t46_sub
    JR      R31
t46_after

    ; 47 JAL -> JALR R31
    ADDUI   R22, R0, 47
    ADDUI   R2, R0, 1
    JAL     t47_sub
t47_ret
    ADDUI   R2, R0, 3
    NOP
    NOP
    ADDUI   R3, R0, 3
    JAL     check_equal_r2_r3
    J       t47_after
t47_sub
    JALR    R31
t47_after

    ; 48 ADDU -> JR target
    ADDUI   R22, R0, 48
    ADDUI   R2, R0, 1
