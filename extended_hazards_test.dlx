    ; 32 ALU chain -> SW base
    ADDUI   R22, R0, 32
    ADDUI   R15, R0, 1
    ADDUI   R15, R15, 6
    SW      mem0(R15), R8
    NOP
    NOP
    LW      R2, mem7(R0)
    NOP
    NOP
