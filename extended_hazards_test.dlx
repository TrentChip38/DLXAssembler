    ; 28 two previous same rd newest wins SW data
    ADDUI   R22, R0, 28
    ADDUI   R15, R0, 1
    ADDUI   R15, R0, 9
    SW      mem3(R0), R15
    NOP
    NOP
    LW      R2, mem3(R0)
    NOP
    NOP
    ADDUI   R3, R0, 9
