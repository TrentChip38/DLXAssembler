    ADDUI   R22, R0, 65
    ADDUI   R2, R0, 1
    ADDUI   R15, R0, 0
    BEQZ    R15, t67_a
    ADDUI   R2, R0, 99
t67_a
    ADDUI   R15, R0, 1
    BNEZ    R15, t67_b
