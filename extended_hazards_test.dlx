    ; 57 ADDUI -> BEQZ with one gap
    ADDUI   R22, R0, 55
    ADDUI   R2, R0, 1
    ADDUI   R15, R0, 0
    ADDUI   R16, R0, 9
    BEQZ    R15, t57_taken
    ADDUI   R2, R0, 99
t57_taken
    NOP
    NOP
    ADDUI   R3, R0, 1
