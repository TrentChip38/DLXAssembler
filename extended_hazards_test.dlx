t49_ret
    ADDUI   R2, R0, 5
    NOP
    NOP
    ADDUI   R3, R0, 5
    JAL     check_equal_r2_r3
    J       t49_after
t49_sub
    ADDU    R6, R31, R0
    JALR    R6
t49_after

    ; 50 two previous same target register then JR should use newest
    ADDUI   R22, R0, 50
    ADDUI   R2, R0, 1
    JAL     t50_sub
t50_ret
    ADDUI   R2, R0, 6
    NOP
    NOP
    ADDUI   R3, R0, 6
