    ; 39 two previous same rd newest wins branch sees newest nonzero
    ADDUI   R22, R0, 39
    ADDUI   R2, R0, 1
    ADDUI   R15, R0, 0
    ADDUI   R15, R0, 1
    BEQZ    R15, t39_skip
    ADDUI   R2, R0, 2
t39_skip
    NOP
    NOP
    ADDUI   R3, R0, 2
