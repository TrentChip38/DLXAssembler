    ; 59 two-source branch producer setup with one ALU and one independent op
    ADDUI   R22, R0, 57
    ADDUI   R2, R0, 1
    ADDUI   R15, R0, 0
    ADDUI   R16, R0, 3
    BEQZ    R15, t59_taken
    ADDUI   R2, R0, 99
t59_taken
    NOP
    NOP
    ADDUI   R3, R0, 1
