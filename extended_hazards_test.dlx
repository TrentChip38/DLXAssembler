    SW      mem15(R0), R4
t45_target
    NOP
    NOP
    LW      R2, mem15(R0)
    NOP
    NOP
    ADD     R3, R0, R0
    JAL     check_equal_r2_r3

    ; 46 JAL -> JR R31
    ADDUI   R22, R0, 46
    ADDUI   R2, R0, 1
