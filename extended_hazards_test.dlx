    ADDUI   R2, R0, 1
    ADDUI   R15, R0, 1
    ADDUI   R15, R0, 0
    BEQZ    R15, t40_taken
    ADDUI   R2, R0, 99
t40_taken
    NOP
    NOP
    ADDUI   R3, R0, 1
